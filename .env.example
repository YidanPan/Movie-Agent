# Spark-local ComfyUI endpoint. Keep it loopback-only on the Spark host.
COMFY_BASE_URL=http://127.0.0.1:8188
COMFY_TIMEOUT_SECONDS=900
WORKFLOWS_DIR=./workflows
PORT=9071
PROJECTS_DIR=./projects
MOCK_MODE=true
# mock：仅演示流程；comfyui：在 Spark 上逐镜调用已验证的 H3 工作流。
VIDEO_GENERATION_MODE=mock
COMFY_WORKFLOW_TEMPLATE=minimax_h3_t2v_api.json
# Spark 真实部署示例：/home/Developer/ComfyUI-H3/output
COMFY_OUTPUT_DIR=./comfy-output
OUTPUTS_DIR=./outputs
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# 单镜失败后最多尝试次数；可再次点击按钮从已完成镜头后续跑。
COMFY_MAX_RETRIES=2
MODEL_PROVIDER=mock
FILM_LANGUAGE=en
TTS_VOICE=en-US-GuyNeural
# edge_tts：网络语音提供商；none：仅保留计划，不生成音频媒体。
TTS_PROVIDER=edge_tts
TTS_TIMEOUT_SECONDS=240
MODELSCOPE_API_KEY=
MODELSCOPE_API_BASE=https://api-inference.modelscope.cn/v1
MODELSCOPE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# 文本 API 的单次请求上限与总尝试次数（429、网络错误与无效 JSON 会重试）。
# 分镜 JSON 较大，ModelScope 冷启动常超过 90 秒，默认放宽到 240 秒避免"白等一场再重试"。
MODELSCOPE_TIMEOUT_SECONDS=240
MODELSCOPE_MAX_RETRIES=2
# 可选：配置支持 image_url 的视觉模型后，真实视频会抽取关键帧进行角色/场景一致性与版权风险复核。
# 留空时仍会归档关键帧，但会明确标注为待人工视觉复核。
MODELSCOPE_VISION_MODEL=
VISION_KEYFRAMES_PER_SHOT=3
